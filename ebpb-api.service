[Unit]
Description=EBPB Reservas FastAPI Application
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/ebpb4
Environment="PATH=/var/www/ebpb4/.venv/bin"
ExecStart=/var/www/ebpb4/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 4

# Restart policy
Restart=always
RestartSec=5

# Security and performance settings
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
