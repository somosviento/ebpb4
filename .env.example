# Example environment variables for EBPB_Reservas_API
# Copy to .env and adjust values

# For local development use SQLite (file relative to project root)
DATABASE_URL=sqlite:///./ebpb.db

# For production (PostgreSQL example)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ebpb

SECRET_KEY=change-me-in-prod
API_PREFIX=/api
EXPORT_OPENAPI=0
ADMIN_TOKEN=change-this-admin-token
# If the app will be served under a base path (for example via Apache reverse proxy
# at https://example.com/ebpb/), set ROOT_PATH to the base path. This ensures
# FastAPI/OpenAPI generate URLs with the correct prefix. Example:
# ROOT_PATH=/ebpb

# Frontend build-time variables (used in frontend build):
# VITE_BASE is the base path used by Vite to emit asset paths (e.g. '/ebpb/')
# VITE_API_BASE is the base to prepend to API calls at runtime (e.g. '/ebpb/api')
# These are not used by the Python backend directly but helpful for deployment.
# VITE_BASE=/ebpb/
# VITE_API_BASE=/ebpb/api
