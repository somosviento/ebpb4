# Example environment variables for EBPB_Reservas_API
# Copy to .env and adjust values

# For local development use SQLite (file relative to project root)
DATABASE_URL=sqlite:///./ebpb.db

# For production (PostgreSQL example)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ebpb

SECRET_KEY=change-me-in-prod
API_PREFIX=/api
EXPORT_OPENAPI=0
ADMIN_TOKEN=change-this-admin-token
